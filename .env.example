# 复制为 .env 后填写真实值；.env 只留在本机，不要提交或分享。
API_HOST=127.0.0.1
API_PORT=8010

# 留空时数据放在项目根目录的 data/ 下
DATA_DIR=

# JWT 签名密钥，填一段随机长字符串；留空时每次启动随机生成，重启后需重新登录
JWT_SECRET=<随机长字符串>
JWT_EXPIRE_MINUTES=720

# 首次启动时为三个预置账号（engineer、developer、admin）设置的初始密码；留空则不创建账号
SEED_PASSWORD=<初始密码>

# 大模型（DeepSeek，OpenAI 兼容接口）；API Key 留空时跳过模型研判与补丁生成
LLM_MODEL=deepseek-flash
LLM_API_KEY=<你的大模型 API Key>
LLM_BASE_URL=https://api.deepseek.com
# 单次请求超时（秒）与失败后的重试次数
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# 沙箱镜像名，与 sandbox-images/build.ps1 构建出的标签一致
SANDBOX_IMAGE=sec-assess/sandbox-python:3.12
